      ]
    },
    "ur": {
      "ai_reason": "生成式AI采纳为核心，媒体影响视角",
      "ai_score": 5.0,
      "domain_score": 4.0,
      "tldr": "该研究基于\"假定媒体影响\"理论框架，通过多群组分析方法，比较不同技术乐观水平的群体在生成式AI采纳意愿上的驱动因素差异。结果显示：在高技术乐观群体中，感知媒体正向影响对生成式AI采纳的驱动作用更强，而错失恐惧(FOMO)的效应相对减弱；低技术乐观群体则更易受FOMO驱使。研究揭示了技术乐观信念在调节媒体影响感知与AI采纳关系中的边界作用，为针对不同乐观水平受众的AI传播策略提供依据。",
