      "ai_reason": "虚拟人/AI教练为关键变量，技术接受研究",
      "ai_score": 4.0,
      "domain_score": 4.0,
      "tldr": "探究影响老年人接受虚拟健身教练的关键属性。研究采用联合分析法（conjoint analysis）分解虚拟教练的多种属性（如外观、性别、口音、互动方式等），并通过潜在类别分析（latent class analysis）识别老年人中的不同偏好细分群体，为社区化虚拟运动干预项目的设计提供依据。",
      "topic_tags": [
        "人机协作",
        "创新"
      ]
    },
    "ur": {
      "ai_reason": "老年人对虚拟教练接纳，联合分析",
      "ai_score": 3.0,
      "domain_score": 5.0,
      "tldr": "面向社区老年运动项目，通过联合分析(conjoint)与潜在类别分析(LCA)考察老年人对虚拟人健身教练各属性的偏好，识别驱动其接受的关键因素，并依据异质性偏好划分出若干潜在用户类别，为面向老年群体的虚拟教练设计与差异化服务提供依据。",
